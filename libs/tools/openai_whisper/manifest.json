{
  "name": "openai_whisper",
  "description": "Transcribe an audio file using OpenAI Whisper / audio transcriptions. Returns full transcript and word-level timestamps when available.",
  "version": "0.1.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "audio_path": {
        "type": "string",
        "description": "Absolute path to the audio file (webm, mp3, wav, m4a, etc.)"
      },
      "language": {
        "type": "string",
        "description": "Optional ISO language code e.g. 'en'. Omit for auto-detect."
      },
      "model": {
        "type": "string",
        "description": "OpenAI transcription model. Defaults to whisper-1."
      }
    },
    "required": ["audio_path"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "transcript": { "type": "string" },
      "words": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text":  { "type": "string" },
            "start": { "type": "number" },
            "end":   { "type": "number" },
            "type":  { "type": "string" }
          },
          "required": ["text", "start", "end"]
        }
      },
      "language_code": { "type": "string" }
    },
    "required": ["transcript", "words"],
    "additionalProperties": true
  },
  "entrypoint": "libs.tools.openai_whisper.tool:run",
  "env_vars": ["OPENAI_API_KEY"],
  "network_access": true,
  "timeout_ms": 120000,
  "max_memory_mb": 128
}
