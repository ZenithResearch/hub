{
  "name": "update_step_runtime_state",
  "description": "Persist worker-owned runtime/task state for a case step.",
  "version": "0.1.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "case_id": { "type": "string" },
      "step_db_row_id": { "type": "string" },
      "runtime_state_json": { "type": "object" }
    },
    "required": ["case_id", "step_db_row_id", "runtime_state_json"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "request_id": { "type": "string" },
      "ok": { "type": "boolean" },
      "step_db_row_id": { "type": "string" },
      "runtime_updated_at": { "type": ["string", "null"] }
    },
    "required": ["request_id", "ok", "step_db_row_id"],
    "additionalProperties": false
  },
  "entrypoint": "libs.tools.cases.tool:update_step_runtime_state",
  "env_vars": ["CASES_HTTP_URL"],
  "network_access": true,
  "timeout_ms": 10000,
  "max_memory_mb": 128
}
