{
  "name": "write_slot",
  "description": "Write a declared case slot value with agent_run_id provenance.",
  "version": "0.1.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "case_id": { "type": "string" },
      "name": { "type": "string" },
      "value": {},
      "agent_run_id": { "type": "string" }
    },
    "required": ["case_id", "name", "value", "agent_run_id"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "request_id": { "type": "string" },
      "ok": { "type": "boolean" },
      "slot_name": { "type": "string" },
      "agent_run_id": { "type": "string" }
    },
    "required": ["request_id", "ok", "slot_name", "agent_run_id"],
    "additionalProperties": false
  },
  "entrypoint": "libs.tools.cases.tool:write_slot",
  "env_vars": ["CASES_HTTP_URL"],
  "network_access": true,
  "timeout_ms": 10000,
  "max_memory_mb": 128
}
