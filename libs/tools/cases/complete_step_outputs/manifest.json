{
  "name": "complete_step_outputs",
  "description": "Validate and commit a full step output envelope for an output-producing step.",
  "version": "0.1.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "case_id": { "type": "string" },
      "step_db_row_id": { "type": "string" },
      "outputs_json": { "type": "object" },
      "agent_run_id": { "type": "string" },
      "notes": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["case_id", "step_db_row_id", "outputs_json"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "request_id": { "type": "string" },
      "ok": { "type": "boolean" },
      "step_db_row_id": { "type": "string" },
      "completed_at": { "type": ["string", "null"] }
    },
    "required": ["request_id", "ok", "step_db_row_id"],
    "additionalProperties": false
  },
  "entrypoint": "libs.tools.cases.tool:complete_step_outputs",
  "env_vars": ["CASES_HTTP_URL"],
  "network_access": true,
  "timeout_ms": 10000,
  "max_memory_mb": 128
}
