# This file contains identifiers and configuration only; secret values must
# be written directly to Secrets Manager and never placed in tfvars.
aws_region         = "us-east-1"
ami_id             = "ami-0123456789abcdef0"
matrix_server_name = "matrix.example.com"

instance_type      = "t3.small"
data_volume_size_gb = 30

# First apply with false to create the empty secret. Set true only after an
# AWSCURRENT version with the exact documented JSON keys has been added.
enable_runtime = false
