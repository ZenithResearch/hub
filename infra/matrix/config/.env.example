# Matrix / Synapse — environment variables
# Copy to .env in the hub root and fill in values before starting

# Required
MATRIX_SERVER_NAME=matrix.yourdomain.com
MATRIX_DB_PASSWORD=change_me_strong_password

# Secrets — generate with: openssl rand -hex 32
MATRIX_REGISTRATION_SECRET=change_me
MATRIX_MACAROON_SECRET=change_me
MATRIX_FORM_SECRET=change_me

# Database defaults (match docker-compose service names)
MATRIX_DB_USER=synapse
MATRIX_DB_NAME=synapse
MATRIX_DB_HOST=matrix-db
MATRIX_DB_PORT=5432

# Ports (local only — override if 8008/8448 conflict with other services)
MATRIX_HTTP_PORT=8008
MATRIX_HTTPS_PORT=8448

# Federation — set false for closed single-hub deployment
MATRIX_FEDERATION_ENABLED=true

# Public registration — keep false, create accounts via admin API
MATRIX_ENABLE_REGISTRATION=false
MATRIX_REPORT_STATS=no
