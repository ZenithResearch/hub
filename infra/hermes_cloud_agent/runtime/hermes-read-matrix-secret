#!/usr/bin/env python3
from __future__ import annotations

import json
import sys
from typing import Any

import boto3


def load_matrix_secret(secret_arn: str, *, client: Any | None = None) -> str:
    if not secret_arn.startswith("arn:"):
        raise ValueError("invalid Secrets Manager ARN")

    secrets = client if client is not None else boto3.client("secretsmanager")
    response = secrets.get_secret_value(SecretId=secret_arn)
    secret = response.get("SecretString")
    if not isinstance(secret, str) or not secret:
        raise ValueError("Matrix secret must use a non-empty SecretString")

    try:
        payload = json.loads(secret)
    except json.JSONDecodeError as exc:
        raise ValueError("Matrix secret must be a JSON object") from exc
    if not isinstance(payload, dict) or set(payload) != {"access_token", "device_id"}:
        raise ValueError("Matrix secret must contain exactly access_token and device_id")
    for key in ("access_token", "device_id"):
        value = payload[key]
        if not isinstance(value, str) or not value or "\n" in value or "\r" in value:
            raise ValueError(f"Matrix secret field {key} must be a non-empty single-line string")

    return json.dumps(payload, separators=(",", ":"), sort_keys=True)


def main() -> int:
    if len(sys.argv) != 2 or not sys.argv[1].startswith("arn:"):
        print("expected one Secrets Manager ARN", file=sys.stderr)
        return 2

    try:
        secret = load_matrix_secret(sys.argv[1])
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 1

    sys.stdout.write(secret)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
