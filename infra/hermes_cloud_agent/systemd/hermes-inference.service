[Unit]
Description=Loopback-only pinned llama.cpp inference for Hermes
Requires=hermes-inference-prepare.service
After=hermes-inference-prepare.service
Before=hermes-cloud-agent.service
PartOf=hermes-cloud-agent.service
Upholds=hermes-cloud-agent.service
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=hermes-inference
Group=hermes-inference
SupplementaryGroups=
Environment=HOME=/nonexistent
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE AWS_CONFIG_FILE AWS_SHARED_CREDENTIALS_FILE
UMask=0077
ExecStartPre=+/usr/local/libexec/hermes-inference-network-preflight
ExecStart=/opt/hermes/venv/bin/python /usr/local/libexec/hermes-inference-supervisor
Restart=on-failure
RestartSec=10s
TimeoutStartSec=20min
TimeoutStopSec=45s
WatchdogSec=90s
KillMode=control-group
OOMPolicy=stop
CPUAccounting=true
CPUQuota=750%
MemoryAccounting=true
MemoryHigh=20G
MemoryMax=24G
TasksAccounting=true
TasksMax=128
LimitNOFILE=4096
LimitNPROC=128
LimitCORE=0
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=tcp:ipv4:8080
InaccessiblePaths=/etc/hermes-cloud-agent/profile.json \
  /etc/hermes-cloud-agent/profile.schema.json \
  /etc/hermes-cloud-agent/config.yaml \
  /etc/hermes-cloud-agent/state-volume-id \
  /var/lib/hermes/profiles \
  /var/lib/hermes/podman \
  /run/hermes-podman
ReadOnlyPaths=/etc/hermes-cloud-agent/local-inference.lock.json \
  /etc/hermes-cloud-agent/local-inference-lock.schema.json \
  /opt/hermes/inference \
  /var/lib/hermes/inference \
  /var/lib/hermes/models

[Install]
WantedBy=multi-user.target
