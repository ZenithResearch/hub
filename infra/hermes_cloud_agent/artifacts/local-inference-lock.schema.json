{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenith-research.ca/schemas/hermes-cloud-agent-local-inference-lock-v1.json",
  "title": "Hermes cloud-agent immutable local inference artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "desired"],
  "properties": {
    "schema_version": {"const": 1},
    "desired": {"$ref": "#/$defs/generation"},
    "rollback": {"$ref": "#/$defs/generation"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "s3Bucket": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "s3Key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\*?\\[\\]])[^\\u0000-\\u001f]+$"
    },
    "s3VersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {"enum": ["null", "latest"]},
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "llamaCpp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "release",
        "archive_filename",
        "archive_sha256",
        "size_bytes",
        "s3_bucket",
        "s3_key",
        "s3_version_id"
      ],
      "properties": {
        "repository": {"const": "https://github.com/ggml-org/llama.cpp"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "release": {"type": "string", "pattern": "^b[1-9][0-9]*$"},
        "archive_filename": {
          "type": "string",
          "pattern": "^llama-b[1-9][0-9]*-bin-ubuntu-x64\\.tar\\.gz$"
        },
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "s3_bucket": {"$ref": "#/$defs/s3Bucket"},
        "s3_key": {"$ref": "#/$defs/s3Key"},
        "s3_version_id": {"$ref": "#/$defs/s3VersionId"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "revision",
        "filename",
        "model_id",
        "sha256",
        "size_bytes",
        "s3_bucket",
        "s3_key",
        "s3_version_id",
        "license",
        "context_length",
        "chat_template",
        "tool_calling_verified"
      ],
      "properties": {
        "source_repository": {
          "type": "string",
          "pattern": "^https://huggingface\\.co/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.gguf$"},
        "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "s3_bucket": {"$ref": "#/$defs/s3Bucket"},
        "s3_key": {"$ref": "#/$defs/s3Key"},
        "s3_version_id": {"$ref": "#/$defs/s3VersionId"},
        "license": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "context_length": {"type": "integer", "minimum": 1024, "maximum": 131072},
        "chat_template": {"const": "jinja"},
        "tool_calling_verified": {"type": "boolean"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["llama_cpp", "model"],
      "properties": {
        "llama_cpp": {"$ref": "#/$defs/llamaCpp"},
        "model": {"$ref": "#/$defs/model"}
      }
    }
  }
}
