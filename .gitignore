.DS_Store

# repos/workspace/ — local repos not contributed to the main project
# Add any personal, client, or experimental repos here; they will not be tracked.
repos/workspace/*
!repos/workspace/.gitkeep
infra/matrix/config/homeserver-local.yaml
infra/matrix/appservices/*.resolved.yaml

