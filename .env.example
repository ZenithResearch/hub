# Hub → Vault integration
# Set to the absolute path of the vault co-located with this hub instance.
# Local dev: path to your local vault (e.g. ../vault for sibling repo)
# Production: path on the server (e.g. /opt/hub/vault)
# Leave unset to disable vault writes (hub logs a warning but won't crash).
VAULT_PATH=../vault

HTTP_PORT=8080
RUNTIME_GRPC_TARGET=runtime-grpc:50051
TOOL_SANDBOX_GRPC_TARGET=tool-sandbox:50052
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

LOG_LEVEL=info
CORS_ALLOW_ORIGINS=http://localhost:3000
MAX_BODY_BYTES=262144
REVIEWS_DATA_DIR=data/reviews
# Review/client registry uses Postgres locally and in production.
CLIENTS_DB_BACKEND=postgres
# Local compose starts `clients-postgres` with these development defaults.
# Production injects the same split fields, with only CLIENTS_PG_PASSWORD from Secrets Manager.
CLIENTS_PG_HOST=clients-postgres
CLIENTS_PG_PORT=5432
CLIENTS_PG_DATABASE=hub_clients
CLIENTS_PG_USER=hub_clients
CLIENTS_PG_PASSWORD=hub_clients_dev_password
# Optional local override for direct/non-compose runs:
# CLIENTS_DATABASE_URL=postgresql://hub_clients:<password>@localhost:5432/hub_clients
# Operator-only Review Access rotation endpoint. Keep secret; never expose to frontend apps.
REVIEW_ACCESS_ADMIN_TOKEN=

# Knowledge base — Frank's process and knowledge content
KB_BASE_DIR=/app/base

TOOL_DIR=/app/libs/tools
TOOL_DEFAULT_TIMEOUT_MS=5000
TOOL_DEFAULT_MAX_MEMORY_MB=128

# Matrix inbox — review submissions route through the feedback room via appservices.
# Run scripts/setup_matrix_bots.sh to generate tokens and registration files.
# GATEWAY_BOT_AS_TOKEN sends as_token to Synapse.
# GATEWAY_BOT_HS_TOKEN sends hs_token to gateway-bot.
# BRIDGE_BOT_HS_TOKEN sends hs_token to matrix-bridge.
# ISS-P15-003 scope: production target synapse.zenith-research.ca (public identity preserved via MATRIX_SERVER_NAME)
# Contract guard for iss-p15-003: MATRIX_HOMESERVER_URL must be overridden per-env; localhost only for dev; prod uses https://synapse.zenith-research.ca ; MATRIX_SERVER_NAME stays public identity
MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_GATEWAY_BOT_USER_ID=@gateway-bot:localhost
GATEWAY_BOT_AS_TOKEN=
GATEWAY_BOT_HS_TOKEN=
BRIDGE_BOT_AS_TOKEN=
BRIDGE_BOT_HS_TOKEN=
MATRIX_FEEDBACK_ROOM_ID=

# Optional Sophia Matrix appservice. Run scripts/setup_matrix_sophia.sh to
# generate fork-local tokens and register @sophia:<server> with Synapse.
MATRIX_REGISTER_SOPHIA_APP_SERVICE=false
SOPHIA_AS_URL=http://ingest:8083
SOPHIA_MATRIX_USER=@sophia:localhost
SOPHIA_AS_TOKEN=
SOPHIA_HS_TOKEN=

# Frank — LLM model selection
FRANK_MODEL=gemini-2.0-flash-lite
GOOGLE_API_KEY=

# Frank — speech-to-text (STT) provider selection for review audio.
# Local default: local Whisper through the stt-http service.
# Production default: ElevenLabs Scribe v2 with local Whisper fallback.
# Options:
#   STT_PROVIDER=local_whisper|elevenlabs
#   STT_MODEL=tiny|base|small|medium|large|large-v2|large-v3|turbo|scribe_v2
#   STT_FALLBACK_PROVIDER=local_whisper|elevenlabs|none
#   STT_AUDIO_PREPROCESSOR=none|elevenlabs_audio_isolation
STT_PROVIDER=local_whisper
STT_MODEL=tiny
STT_FALLBACK_PROVIDER=none
STT_AUDIO_PREPROCESSOR=none
STT_HTTP_URL=http://stt-http:8765
# Required only when STT_PROVIDER=elevenlabs or STT_AUDIO_PREPROCESSOR=elevenlabs_audio_isolation.
# Production should inject this from AWS Secrets Manager, not from a committed file.
ELEVENLABS_API_KEY=

# Optional overrides (safe defaults used if unset)
RUNTIME_GRPC_BIND=0.0.0.0:50051
TOOL_SANDBOX_GRPC_BIND=0.0.0.0:50052
KB_VECTOR_DIM=256
QDRANT_COLLECTION=kb_documents
ALLOW_TOOLS_WITH_NETWORK=true
